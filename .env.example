# Copy to .env. Never commit real secrets.
POSTGRES_USER=workflowops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workflowops

WFO_ENV=dev
WFO_LOG_LEVEL=INFO
# Local MySQL (see ADR-0005), e.g. mysql+aiomysql://USER:PASSWORD@localhost:3306/workflowops
# Falls back to SQLite if unset; docker-compose overrides this with Postgres.
WFO_DATABASE_URL=sqlite+aiosqlite:///./workflowops.db
WFO_MOCK_SYSTEMS_URL=http://localhost:8100
WFO_MEDIUM_RISK_REQUIRES_APPROVAL=false
WFO_APPROVAL_TTL_HOURS=72

# LLM provider key (Phase 3+): Google Gemini for all frameworks. Tests use the fake LLM.
GOOGLE_API_KEY=

# LLM model shared by every framework
WFO_LLM_MODEL=gemini-3.5-flash
