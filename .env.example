# Copy to .env. Never commit real secrets.
POSTGRES_USER=workflowops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workflowops

WFO_ENV=dev
WFO_LOG_LEVEL=INFO
# Local (non-docker) default is SQLite; docker-compose overrides this with Postgres.
WFO_DATABASE_URL=sqlite+aiosqlite:///./workflowops.db
WFO_MOCK_SYSTEMS_URL=http://localhost:8100
WFO_MEDIUM_RISK_REQUIRES_APPROVAL=false
WFO_APPROVAL_TTL_HOURS=72

# LLM provider keys (Phase 3+). Leave empty: CI and tests use the fake LLM.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
