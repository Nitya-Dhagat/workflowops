{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mock-systems",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "mock_business_systems.app:app", "--port", "8100"],
      "port": 8100
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "backend.api.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev"],
      "port": 3000
    }
  ]
}
